PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/securitygateway
JWT_ACCESS_SECRET=change_me_long_random_string_1
JWT_REFRESH_SECRET=change_me_long_random_string_2

# Comma-separated list of allowed browser origins (strict CORS allow-list)
CLIENT_URL=http://localhost:5000

# Public URL of THIS server (used to build OAuth callback URLs)
BASE_URL=http://localhost:5000

# OAuth (fill in at least one provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
